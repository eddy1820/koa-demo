# Docker 環境變數範例
# 此檔案展示在 Docker Compose 環境中使用的環境變數
# 與 .env.example 的主要差異在於資料庫連線設定

# Server
NODE_ENV=development
PORT=3000

# Database (PostgreSQL in Docker)
# 注意：DB_HOST 使用 Docker Compose 服務名稱而非 localhost
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=test1

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=*
