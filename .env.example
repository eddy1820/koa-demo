# Server
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=test1

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
# Token expiration in seconds (86400 = 24 hours)
JWT_EXPIRES_IN=86400

# CORS
CORS_ORIGIN=*
