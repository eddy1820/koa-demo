{
  "title": "Koa Demo Application Monitoring",
  "uid": "koa-demo-app",
  "version": 1,
  "timezone": "browser",
  "refresh": "10s",
  "tags": ["koa", "nodejs", "application"],
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "rate(koa_demo_http_requests_total[1m])" }]
    },
    {
      "id": 2,
      "title": "HTTP Request Duration (95th percentile)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "histogram_quantile(0.95, rate(koa_demo_http_request_duration_seconds_bucket[5m]))" }]
    },
    {
      "id": 3,
      "title": "HTTP Status Code Distribution",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [{ "expr": "sum by (status_code) (increase(koa_demo_http_requests_total[5m]))" }]
    },
    {
      "id": 4,
      "title": "Database Query Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [{ "expr": "rate(koa_demo_db_queries_total[1m])" }]
    },
    {
      "id": 5,
      "title": "Database Query Duration (95th percentile)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [{ "expr": "histogram_quantile(0.95, rate(koa_demo_db_query_duration_seconds_bucket[5m]))" }]
    },
    {
      "id": 6,
      "title": "Node.js Memory Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "koa_demo_process_resident_memory_bytes", "legendFormat": "RSS Memory" },
        { "expr": "koa_demo_nodejs_heap_size_used_bytes", "legendFormat": "Heap Used" }
      ]
    },
    {
      "id": 7,
      "title": "CPU Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [{ "expr": "rate(koa_demo_process_cpu_seconds_total[1m]) * 100" }]
    },
    {
      "id": 8,
      "title": "Event Loop Lag",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "targets": [{ "expr": "koa_demo_event_loop_lag_seconds" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.1 }
            ]
          }
        }
      }
    },
    {
      "id": 9,
      "title": "Database Connection Pool",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "targets": [
        { "expr": "koa_demo_db_connection_pool_size", "legendFormat": "Pool Size" },
        { "expr": "koa_demo_db_connection_pool_active", "legendFormat": "Active Connections" }
      ]
    },
    {
      "id": 10,
      "title": "User Registrations (24h)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "targets": [{ "expr": "sum(increase(koa_demo_user_registrations_total{status=\"success\"}[24h]))" }]
    },
    {
      "id": 11,
      "title": "User Logins (24h)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 32 },
      "targets": [{ "expr": "sum(increase(koa_demo_user_logins_total[24h]))" }]
    },
    {
      "id": 12,
      "title": "Failed Login Attempts (24h)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 32 },
      "targets": [{ "expr": "sum(increase(koa_demo_user_login_failures_total[24h]))" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      }
    }
  ]
}
